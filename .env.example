# ---- Feed: sim | pumpportal | rpc
FEED_MODE=pumpportal
# Fastest path: your own low-latency RPC websocket (Helius / Triton / QuickNode / private node)
# FEED_MODE=rpc
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

PORT=8787
STARTING_SOL=10

# ---- Paper execution model (be pessimistic)
PAPER_LATENCY_MS=400
PAPER_FAIL_RATE=0.06
PRIORITY_FEE_SOL=0.0003
JITO_TIP_SOL=0.0005

# ---- Learning loop
EVOLVE_EVERY_SEC=600
EVOLVE_WINDOW_MIN=60
MIN_TAPE_MIN=10
PATCH_AFTER_LOSSES=3
PATCH_COOLDOWN_SEC=300

# ---- Optional LLM brain (Researcher proposals). Grok is used if both are set.
# XAI_API_KEY=
# XAI_MODEL=grok-4
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Protect pause/reset/evolve if you host the UI publicly
# CONTROL_TOKEN=change-me
